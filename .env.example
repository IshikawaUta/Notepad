# Wajib
SECRET_KEY=ganti-dengan-secret-random-64-char
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB_NAME=catatan

# Akun admin default (dibuat saat startup bila belum ada)
# JANGAN pakai password lemah — generate: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# App
DEV_MODE=1
BASE_URL=http://localhost:8000
SITE_NAME=Catatan
SITE_TAGLINE=Tulis, simpan, dan bagikan catatan markdown

# Backblaze B2 (opsional — kosongkan untuk penyimpanan lokal)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_BUCKET_ID=
B2_ENDPOINT=

# Rate limit global (opsional)
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=60

# Upload
MAX_UPLOAD_SIZE=5242880
